# Database - SQLite for local dev (no Postgres required)
DATABASE_URL=sqlite+aiosqlite:///./cranes.db
# For production with PostgreSQL, use:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cranes_chatbot

# Auth / JWT
SECRET_KEY=change-me-to-a-random-32-char-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# LLM
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
MAX_TOKENS=2048
TEMPERATURE=0.7

# RAG / Embeddings / Vector
EMBEDDING_MODEL=text-embedding-004
VECTOR_DATABASE_URL=
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Storage
STORAGE_PROVIDER=local
STORAGE_PATH=./storage
# For S3 / Cloudinary / Supabase, configure:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_BUCKET=
# CLOUDINARY_URL=
# SUPABASE_URL=
# SUPABASE_KEY=

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,*

# App
APP_ENV=development
